{
  "name": "brookfield",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "build": "cross-env NODE_OPTIONS=--experimental-sqlite next build",
    "dev": "cross-env NODE_OPTIONS=--experimental-sqlite next dev",
    "start": "cross-env NODE_OPTIONS=--experimental-sqlite next start",
    "lint": "eslint",
    "db:seed": "cross-env NODE_OPTIONS=--experimental-sqlite DOTENV_CONFIG_PATH=.env.local tsx scripts/seed.ts",
    "db:bootstrap:preview": "cross-env NODE_OPTIONS=--experimental-sqlite DOTENV_CONFIG_PATH=.env.local tsx scripts/bootstrap-preview-d1.ts",
    "db:reset": "rm -rf .data",
    "preview:staging": "opennextjs-cloudflare build && npm run db:bootstrap:preview && opennextjs-cloudflare preview --env staging",
    "deploy:staging": "opennextjs-cloudflare build && opennextjs-cloudflare deploy --env staging",
    "upload:staging": "opennextjs-cloudflare build && opennextjs-cloudflare upload --env staging",
    "cf-typegen": "wrangler types --env-interface CloudflareEnv cloudflare-env.d.ts"
  },
  "dependencies": {
    "@opennextjs/cloudflare": "^1.20.13",
    "bcryptjs": "^3.0.3",
    "jose": "^6.2.12",
    "lucide-react": "^1.46.0",
    "next": "16.4.3",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^22.20.2",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "cross-env": "^7.0.3",
    "dotenv": "^17.4.2",
    "eslint": "^9",
    "eslint-config-next": "16.4.3",
    "tailwindcss": "^4",
    "tsx": "^4.23.13",
    "typescript": "^5",
    "wrangler": "^4.152.0"
  }
}
